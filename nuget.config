<?xml version="1.0" encoding="utf-8"?>
<!--
  Temporary local bridge: resolves StrongSort.Net from a local .nupkg produced by the
  sibling StrongSort.NET repo, so this project builds before StrongSort.Net is on NuGet.org.
  Once StrongSort.Net is published, this local source can be removed and the package will
  restore from nuget.org normally.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="strongsort-local" value="../StrongSort.NET/artifacts" />
  </packageSources>
</configuration>
