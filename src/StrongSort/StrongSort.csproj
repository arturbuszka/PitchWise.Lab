<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <PackageId>StrongSort.Net</PackageId>
    <Version>0.1.0</Version>
    <Authors>Artur Buszka</Authors>
    <Description>Pure C# implementation of the StrongSORT multi-object tracker (DeepSORT with NSA Kalman filter, EMA appearance embedding and combined appearance/motion matching). No native or ML dependencies — bring your own detector and ReID embeddings.</Description>
    <PackageTags>tracking;mot;strongsort;deepsort;kalman;computer-vision</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="StrongSort.Tests" />
  </ItemGroup>

</Project>
