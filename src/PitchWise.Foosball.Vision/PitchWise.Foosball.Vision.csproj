<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- The only foosball project that touches pixels. Native OpenCV runtimes are referenced by
       executables and test projects, since native assets only flow to their output. -->
  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
    <!-- Same ONNX Runtime packages as PitchWise.GameState, so one native runtime serves both. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" Condition="!$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu.Linux" Version="1.24.4" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PitchWise.Foosball\PitchWise.Foosball.csproj" />
  </ItemGroup>

</Project>
